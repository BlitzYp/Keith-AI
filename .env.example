# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands to one server instantly (otherwise global, can take a while)
DISCORD_GUILD_ID=

# --- LLM (any OpenAI-compatible endpoint) ---
# Local llama.cpp server:  http://localhost:8080/v1   (API key can be anything)
# Local Ollama:            http://localhost:11434/v1
# OpenRouter:              https://openrouter.ai/api/v1
# Groq:                    https://api.groq.com/openai/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed-for-local
LLM_MODEL=qwen3:8b
# Keith looks at pictures sent with a message. Set to false if the model is text-only
# (e.g. Groq's openai/gpt-oss-120b): the request would fail otherwise.
LLM_SEES_IMAGES=true

# Personality
BOT_NAME=Jarvis
# Keith's personality: a Markdown file, re-read for every reply (edit it while Keith runs).
# {{name}} in it becomes BOT_NAME; <!-- comments --> are left out.
SYSTEM_PROMPT_FILE=./prompts/jarvis.md
# Or write a short prompt here instead; if set, it wins over the file.
# SYSTEM_PROMPT=You are Keith, a friendly member of this Discord server.

# How many recent messages per channel to keep as context
HISTORY_MAX_MESSAGES=20

# --- Piper TTS ---
# Python with piper-tts installed (see README) and a voice model (.onnx with its .onnx.json next to it)
PIPER_PYTHON=.venv/Scripts/python.exe
PIPER_MODEL=./models/en_US-lessac-medium.onnx

# --- Speech-to-text (Keith listening in voice) ---
# api:   an OpenAI-compatible transcription endpoint. Uses LLM_BASE_URL / LLM_API_KEY unless set
#        below. Groq has whisper-large-v3-turbo.
# local: faster-whisper on this machine (see README step 4). base.en is quick on a laptop CPU;
#        small.en is more accurate but about 3x slower.
STT_ENGINE=local
# A language code, or "auto" to let Whisper guess (less reliable on short sentences)
STT_LANGUAGE=en
# Whisper reads this as what was just said, which can help it spell the bot's name right.
# Default: "A voice chat with <BOT_NAME> and friends." for local, none for api (prompts made
# Groq worse in testing). "none" turns it off.
# STT_PROMPT=A voice chat with Keith and friends.
WHISPER_MODEL=base.en
# Defaults to PIPER_PYTHON: install faster-whisper in the same venv
# WHISPER_PYTHON=.venv/Scripts/python.exe
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
