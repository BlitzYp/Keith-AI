# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands to one server instantly (otherwise global, can take a while)
DISCORD_GUILD_ID=

# --- LLM (any OpenAI-compatible endpoint) ---
# Local llama.cpp server:  http://localhost:8080/v1   (API key can be anything)
# Local Ollama:            http://localhost:11434/v1
# OpenRouter:              https://openrouter.ai/api/v1
# Groq:                    https://api.groq.com/openai/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed-for-local
LLM_MODEL=qwen3:8b

# Personality
BOT_NAME=Keith
SYSTEM_PROMPT=You are Keith, a friendly, witty member of this Discord server. Keep replies short and conversational, a few sentences at most, because they may be read aloud. No markdown tables or code blocks unless asked.

# How many recent messages per channel to keep as context
HISTORY_MAX_MESSAGES=20

# --- Piper TTS ---
# Python with piper-tts installed (see README) and a voice model (.onnx with its .onnx.json next to it)
PIPER_PYTHON=.venv/Scripts/python.exe
PIPER_MODEL=./models/en_US-lessac-medium.onnx
