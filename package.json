{
  "name": "discord-keith-ai",
  "version": "0.1.0",
  "description": "Keith: a Discord AI bot that chats in text and speaks in voice channels with Piper TTS",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "voice:report": "tsx src/scripts/voiceReport.ts"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.1.12",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "ffmpeg-static": "^5.3.0",
    "openai": "^7.45.1",
    "opusscript": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
